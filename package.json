{
  "name": "fm-league",
  "private": true,
  "version": "0.1.0",
  "description": "FM27 风格轻度 Rogue 足球联赛（Steam & 微信小游戏双端同构）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:web": "esbuild apps/steam/src/main.ts --bundle --format=iife --outfile=apps/steam/steam.bundle.js && esbuild packages/engine/src/index.ts --bundle --format=iife --global-name=FMLeagueEngine --minify --outfile=apps/steam/engine.iife.js",
    "build:engine": "npm run build --workspace=@fm-league/engine",
    "sim:100": "npm run sim:100 --workspace=@fm-league/engine"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
